\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The Cognitive Adapter is inserted after the self-attention and feed-forward layers in each Swin-T block, where adaptive layer normalization, depthwise convolution and residual connections are employed to boost feature expressiveness.}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:Cognitive_Adapter}{{4}{4}{The Cognitive Adapter is inserted after the self-attention and feed-forward layers in each Swin-T block, where adaptive layer normalization, depthwise convolution and residual connections are employed to boost feature expressiveness}{figure.4}{}}
