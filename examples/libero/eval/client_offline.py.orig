#!/usr/bin/env python3
"""Replay LIBERO dataset observations through the online inference server."""

from __future__ import annotations

import argparse
import asyncio
import json
import uuid
from pathlib import Path
from typing import Any

import numpy as np
import websockets
from rich.console import Console

from examples.libero.config.data_config import LIBERO_DATASET_DIR
from examples.libero.eval.client import _draw_response_points, _save_video_ffmpeg
from examples.libero.config.model_config import LIBERO_MODEL_CONFIG
from src.dataset.dataset import make_lerobot_dataset


cs = Console()
DEFAULT_OUTPUT_DIR = Path(__file__).resolve().parent / "output_offline"
DEFAULT_OUTPUT_PATH = DEFAULT_OUTPUT_DIR / "responses.jsonl"


def _parse_int_list(value: str) -> list[int]:
    values = [int(item.strip()) for item in value.split(",") if item.strip()]
    if not values:
        raise argparse.ArgumentTypeError("expected at least one integer")
    return values


def _to_numpy(value: Any) -> np.ndarray:
    if hasattr(value, "detach"):
        value = value.detach().cpu()
    return np.asarray(value)


def _to_rgb_uint8(value: Any) -> np.ndarray:
    image = _to_numpy(value)
    if image.ndim != 3:
        raise ValueError(f"expected a 3-D RGB image, got shape={image.shape}")
    if image.shape[0] == 3 and image.shape[-1] != 3:
        image = np.moveaxis(image, 0, -1)
    if image.shape[-1] != 3:
        raise ValueError(f"expected RGB channels, got shape={image.shape}")
    if np.issubdtype(image.dtype, np.floating):
        image = np.rint(np.clip(image, 0.0, 1.0) * 255.0)
    return np.ascontiguousarray(image, dtype=np.uint8)


def _scalar(value: Any) -> int:
    return int(_to_numpy(value).item())


def _load_cameras(path: Path) -> dict[int, tuple[np.ndarray, np.ndarray]]:
    with path.open("r", encoding="utf-8") as file:
        rows = json.load(file)
    cameras = {}
    for row in rows:
        task_index = int(row["task_index"])
        agentview = row["cameras"]["agentview"]
        intrinsic = np.asarray(agentview["intrinsic"], dtype=np.float64)
        extrinsic = np.asarray(agentview["extrinsic"], dtype=np.float64)
        if intrinsic.shape != (3, 3) or extrinsic.shape != (4, 4):
            raise ValueError(
                f"invalid agentview matrices for task {task_index}: "
                f"intrinsic={intrinsic.shape}, extrinsic={extrinsic.shape}"
            )
        cameras[task_index] = intrinsic, extrinsic
    return cameras


async def _replay_episode(
    *,
    uri: str,
    dataset_dir: Path,
    episode_index: int,
    cameras: dict[int, tuple[np.ndarray, np.ndarray]],
    output_file: Any,
    start_frame: int,
    max_frames: int | None,
    frame_stride: int,
    execute_chunk_len: int,
    video_dir: Path,
    save_video: bool,
    video_fps: float,
) -> int:
    dataset = make_lerobot_dataset(
        dataset_dir,
        load_videos=True,
        video_backend="pyav",
        episodes=[episode_index],
    )
    stop = len(dataset) if max_frames is None else min(len(dataset), start_frame + max_frames * frame_stride)
    frame_indices = range(start_frame, stop, frame_stride)
    if start_frame >= len(dataset):
        raise ValueError(f"start frame {start_frame} is outside episode {episode_index} with {len(dataset)} frames")

    session_id = f"libero-dataset-{episode_index:06d}-{uuid.uuid4().hex[:8]}"
    count = 0
    async with websockets.connect(uri, max_size=None, proxy=None) as websocket:
        for local_index in frame_indices:
            sample = dataset[local_index]
            sample_episode = _scalar(sample["episode_index"])
            frame_index = _scalar(sample["frame_index"])
            task_index = _scalar(sample["task_index"])
            if sample_episode != episode_index:
                raise RuntimeError(f"requested episode {episode_index}, dataset returned {sample_episode}")
            if task_index not in cameras:
                raise KeyError(f"cameras.json has no entry for task_index={task_index}")
            intrinsic, extrinsic = cameras[task_index]
            image = _to_rgb_uint8(sample["observation.images.image"])
            state = _to_numpy(sample["observation.state"]).astype(np.float64)

            request = {
                "benchmark": "libero",
                "session_id": session_id,
                "language": str(sample["task"]),
                "execute_chunk_len": execute_chunk_len,
                "observation.images.image": [image.tolist()],
                "observation.state": [state.tolist()],
                "camera.intrinsics": [intrinsic.tolist()],
                "camera.extrinsics": [extrinsic.tolist()],
            }
            if count == 0:
                request["reset"] = True

            await websocket.send(json.dumps(request))
            response = json.loads(await websocket.recv())
            if "error" in response:
                raise RuntimeError(
                    f"server failed at episode={episode_index} frame={frame_index}: {response['error']}"
                )

            record = {
                "episode_index": episode_index,
                "frame_index": frame_index,
                "dataset_index": _scalar(sample["index"]),
                "task_index": task_index,
                "task": str(sample["task"]),
                "gt_subtask": str(sample["subtask"]),
                "gt_subtask_id": _scalar(sample["subtask_id"]),
                "gt_is_complete": bool(_to_numpy(sample["is_complete"]).item()),
                "gt_action": _to_numpy(sample["action"]).tolist(),
                "response": response,
            }
            output_file.write(json.dumps(record) + "\n")
            output_file.flush()
            count += 1
            cs.print(
                f"episode={episode_index} frame={frame_index} "
                f"server_subtask={response.get('subtask_index')} saved"
            )
    return count


async def _run(args: argparse.Namespace) -> None:
    dataset_dir = Path(args.dataset_dir)
    camera_path = Path(args.cameras_path) if args.cameras_path else dataset_dir / "meta" / "cameras.json"
    cameras = _load_cameras(camera_path)
    output_path = Path(args.output_path)
    output_path.parent.mkdir(parents=True, exist_ok=True)
    uri = f"ws://{args.host}:{args.port}"

    total = 0
    with output_path.open("w", encoding="utf-8") as output_file:
        for episode_index in args.episodes:
            total += await _replay_episode(
                uri=uri,
                dataset_dir=dataset_dir,
                episode_index=episode_index,
                cameras=cameras,
                output_file=output_file,
                start_frame=args.start_frame,
                max_frames=args.max_frames,
                frame_stride=args.frame_stride,
                execute_chunk_len=args.execute_chunk_len,
            )
    cs.print(f"saved {total} frame responses to: {output_path}")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Replay dataset RGB/state frames through the full online LIBERO server preprocessing pipeline."
    )
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8001)
    parser.add_argument("--dataset-dir", default=LIBERO_DATASET_DIR)
    parser.add_argument("--cameras-path", default=None)
    parser.add_argument("--episodes", type=_parse_int_list, default=[0])
    parser.add_argument("--start-frame", type=int, default=0)
    parser.add_argument("--max-frames", type=int, default=None)
    parser.add_argument("--frame-stride", type=int, default=1)
    parser.add_argument("--execute-chunk-len", type=int, default=int(LIBERO_MODEL_CONFIG.future_horizon))
    parser.add_argument("--output-path", default=DEFAULT_OUTPUT_PATH)
    args = parser.parse_args()
    if args.start_frame < 0:
        parser.error("--start-frame must be non-negative")
    if args.max_frames is not None and args.max_frames < 1:
        parser.error("--max-frames must be positive")
    if args.frame_stride < 1:
        parser.error("--frame-stride must be positive")
    if args.execute_chunk_len < 1:
        parser.error("--execute-chunk-len must be positive")
    return args


def main() -> None:
    asyncio.run(_run(parse_args()))


if __name__ == "__main__":
    main()
